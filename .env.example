DISCORD_TOKEN=

# Backend Mistral (API La Plateforme) : utilisé automatiquement si MISTRAL_API_KEY est renseignée
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
# MISTRAL_URL=https://api.mistral.ai/v1/chat/completions

# Backend Ollama local (utilisé si MISTRAL_API_KEY est vide, ou BACKEND=ollama)
# BACKEND=ollama
# OLLAMA_URL=http://ollama:11434/api/generate

# Mémoire automatique : après chaque réponse, le bot décide seul (2e appel API, JSON)
# si le message mérite d'être retenu dans mémoire.md, qui est réinjecté dans le prompt
MEMOIRE_AUTO=true
# MEMOIRE_FILE=./mémoire.md
# MAX_MEMOIRES=200
